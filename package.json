{
  "name": "chunk-share",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "volta": {
    "node": "24.18.0"
  },
  "scripts": {
    "check:electron": "node scripts/check-electron-install.mjs",
    "clean:dev-data": "node scripts/clean-dev-data.mjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "e2e": "playwright test",
    "e2e:slow": "node scripts/run-slow-e2e.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "archiver": "^8.0.0",
    "extract-zip": "^2.0.1",
    "google-auth-library": "^10.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "msw": "^2.15.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
